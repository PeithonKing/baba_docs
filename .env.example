# Copy to .env and fill in. Keep comments on their own lines.

# Claude model the agent uses, its reasoning effort, and permission mode
# (auto = a classifier approves each action; the agent also has a shell)
GCMV_MODEL=claude-sonnet-5-5
GCMV_EFFORT=medium
GCMV_PERMISSION_MODE=auto

# Device lock: auto (only for requests from the internet) | always | off
GCMV_GUARD=auto
# Public hostname(s) served through Cloudflare, comma separated
GCMV_PUBLIC_HOSTS=docs.example.com

# Claude Code binary (docker-compose sets this to the host's ~/.local/bin/claude)
# GCMV_CLAUDE_CLI=/home/aritra/.local/bin/claude

# Word -> PDF previews: soffice if installed, else Collabora's convert-to endpoint
GCMV_COLLABORA_URL=http://collabora:9980

# His Nextcloud (the server-side address; app password made with
#   docker exec -u www-data nextcloud php occ user:auth-tokens:add -n asish)
NEXTCLOUD_URL=http://nextcloud
NEXTCLOUD_USER=asish
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_FOLDER="School Documents"
# Address his browser uses to open Nextcloud
NEXTCLOUD_PUBLIC_URL=https://drive.example.com
# Where the headmaster's signature PNG is kept in his Nextcloud. Not in git.
NEXTCLOUD_SIGNATURE_PATH="School Documents/Signature/signature.png"
