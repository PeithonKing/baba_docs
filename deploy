#!/usr/bin/env bash
# Put the latest pushed version live on the server. Installed apps (phone / tablet) update
# themselves: the next time he opens or returns to the app it reloads into the new version —
# no reinstalling. (Only a change to the app's name/icon in manifest.webmanifest waits for
# Chrome's own periodic app refresh.)
#
#   git push && ./deploy          pull on the server, rebuild, restart
#   ./deploy --bump               ... and record the new version in the HOMELAB repo (submodule)
#
# Env overrides: BABA_HOST (default pi5), BABA_DIR (default HOMELAB/baba_docs)
set -euo pipefail

HOST=${BABA_HOST:-pi5}
DIR=${BABA_DIR:-HOMELAB/baba_docs}
BUMP=${1:-}

run() { if [ "$(hostname -s)" = "$HOST" ]; then bash -lc "$1"; else ssh -o LogLevel=ERROR "$HOST" "bash -lc '$1'"; fi; }

run "cd ~/$DIR && git pull --ff-only && git log --oneline -1 && docker compose up -d --build"
# wait for the new server to answer (up to ~60 s), then show its build id
run "for i in \$(seq 30); do curl -fsS localhost:8765/api/version 2>/dev/null && echo && exit 0; sleep 2; done; echo 'server did not answer'; exit 1"
if [ "$BUMP" = "--bump" ]; then
  run "cd ~/${DIR%/*} && git add ${DIR##*/} && git commit -m \"${DIR##*/}: \$(git -C ${DIR##*/} log --format=%s -1)\" && git push"
fi
echo "Live. Open apps pick it up the next time they come to the front."
